# Groq API Credentials
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection
# Default recommended model: openai/gpt-oss-120b
# Other valid options: openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# Whisper Model for Voice Answers (speech-to-text transcription)
# Options: whisper-large-v3-turbo (faster, default), whisper-large-v3 (slightly more accurate)
WHISPER_MODEL=whisper-large-v3-turbo
